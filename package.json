{
  "name": "new-luckhurst-wood",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 0.0.0.0",
    "photos": "node scripts/ingest-photos.mjs",
    "photos:from-album": "node scripts/export-luckhurst-album.mjs && node scripts/ingest-photos.mjs",
    "photos:setup-s3": "node scripts/setup-s3.mjs",
    "photos:push": "node scripts/push-diary-s3.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
